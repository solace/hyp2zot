# Copy to .env, fill in, then: chmod 600 .env
# DO NOT COMMIT

# Numeric user ID from https://www.zotero.org/settings/security#applications
ZOTERO_LIBRARY_ID=
# Key with library read, notes read, and library write access. Personal library only.
ZOTERO_API_KEY=
# Hypothesis username
HYPOTHESIS_USERNAME=
# From https://hypothes.is/account/developer
HYPOTHESIS_API_KEY=
